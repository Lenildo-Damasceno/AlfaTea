{
  "expo": {
    "name": "Alfatea",
    "slug": "alfatea",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/2fcb4a25-67a4-4e68-ac7c-2b884d3c82bb"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.alfatea.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7FAFC",
          "image": "./assets/images/alfi/alfi_ola.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Alfatea consulta sua localização apenas quando você solicita recursos próximos, sem guardar sua posição.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-notifications",
      "expo-router",
      "expo-video",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "icon": "./assets/images/branding/icone_alfatea.png",
    "scheme": "alfatea",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2fcb4a25-67a4-4e68-ac7c-2b884d3c82bb"
      }
    }
  }
}
