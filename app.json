{
  "expo": {
    "name": "Alfatea",
    "slug": "alfatea",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.alfatea.app"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7FAFC",
          "image": "./assets/images/alfi/alfi_ola.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Alfatea consulta sua localização apenas quando você solicita recursos próximos, sem guardar sua posição.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-notifications",
      "expo-router",
      "expo-video"
    ],
    "icon": "./assets/images/branding/icone_alfatea.png",
    "scheme": "alfatea"
  }
}
